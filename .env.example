# Mẫu biến môi trường. Sao chép thành .env.local rồi điền giá trị thật (KHÔNG commit .env.local).
# Supabase (dùng từ Pha 5)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Khóa HMAC băm IP/email/id cho bộ đếm giới hạn tần suất (E0-5). Tùy chọn: để trống thì dùng
# SUPABASE_SERVICE_ROLE_KEY. Nên đặt chuỗi ngẫu nhiên riêng ở production (ví dụ: openssl rand -hex 32).
RATE_LIMIT_SECRET=

# Mật khẩu chung cho 4 tài khoản thử cục bộ (make db-seed). Tự đặt, không commit, không dùng lại ở nơi khác.
SEED_PASSWORD=

# Đăng nhập Google (Story E1-2, chưa bật). supabase/config.toml đọc hai biến này qua env().
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
